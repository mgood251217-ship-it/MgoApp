{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability default untuk window utama MgoDesktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "dialog:default",
    "fs:default",
    "store:default",
    "global-shortcut:default",
    "shell:default",
    "core:webview:allow-print",
    "fs:allow-write-file"
  ]
}