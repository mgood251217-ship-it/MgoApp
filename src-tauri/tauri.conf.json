{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MgoDesktop",
  "version": "2.0.1",
  "identifier": "id.mgo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MgoDesktop",
        "width": 1400,
        "height": 900,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Viki Alvian Riyadi",
    "shortDescription": "Aplikasi POS internal Mgo Desktop untuk transaksi cepat, praktis, dan akurat.",
    "copyright": "Copyright © 2026 Viki Alvian Riyadi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/assets/icons/*": "icons/"
    },
    "windows": {
      "nsis": {
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}